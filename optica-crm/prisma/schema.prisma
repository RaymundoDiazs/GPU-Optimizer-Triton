generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  inactive
  suspended
}

enum EmployeeStatus {
  active
  inactive
  terminated
}

enum ContactMethod {
  phone
  whatsapp
  email
}

enum AppointmentStatus {
  scheduled
  confirmed
  attended
  no_show
  cancelled
}

enum AppointmentSource {
  web
  phone
  walk_in
  internal
}

enum CategoryType {
  product
  service
}

enum ProductType {
  frame
  sunglasses
  contact_lens
  lens
  treatment
  accessory
  service
}

enum InventoryMovementType {
  purchase
  sale
  return
  adjustment
  transfer_in
  transfer_out
}

enum SaleStatus {
  quote
  reserved
  confirmed
  paid
  in_process
  ready_for_pickup
  delivered
  cancelled
}

enum FulfillmentStatus {
  pending
  in_process
  ready
  delivered
  cancelled
}

enum PaymentMethod {
  cash
  card
  transfer
  mixed
  other
}

enum PaymentStatus {
  pending
  completed
  refunded
  cancelled
}

enum PayrollStatus {
  draft
  reviewed
  paid
  cancelled
}

model Organization {
  id              String              @id @default(uuid()) @db.Uuid
  name            String
  slug            String              @unique
  legalName       String?             @map("legal_name")
  taxId           String?             @map("tax_id")
  defaultCurrency String              @default("MXN") @map("default_currency")
  timezone        String              @default("America/Mexico_City")
  phone           String?
  email           String?
  website         String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  appointments    Appointment[]
  branches        Branch[]
  brands          Brand[]
  categories      Category[]
  customers       Customer[]
  employees       Employee[]
  inventoryMoves  InventoryMovement[]
  inventoryStock  InventoryStock[]
  payments        Payment[]
  payrollPeriods  PayrollPeriod[]
  products        Product[]
  prescriptions   Prescription[]
  roles           Role[]
  sales           Sale[]
  suppliers       Supplier[]
  users           User[]

  @@map("organizations")
}

model Branch {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  name           String
  code           String
  phone          String?
  email          String?
  addressLine1   String?             @map("address_line_1")
  addressLine2   String?             @map("address_line_2")
  city           String?
  state          String?
  postalCode     String?             @map("postal_code")
  country        String?
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  appointments   Appointment[]
  employees      Employee[]
  inventoryMoves InventoryMovement[]
  inventoryStock InventoryStock[]
  organization   Organization        @relation(fields: [organizationId], references: [id])
  payrollPeriods PayrollPeriod[]
  sales          Sale[]

  @@unique([organizationId, code])
  @@map("branches")
}

model User {
  id                    String              @id @default(uuid()) @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  email                 String
  name                  String
  phone                 String?
  passwordHash          String?             @map("password_hash")
  authProviderId        String?             @map("auth_provider_id")
  status                UserStatus          @default(active)
  lastLoginAt           DateTime?           @map("last_login_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  createdAppointments   Appointment[]       @relation("AppointmentCreatedBy")
  createdInventoryMoves InventoryMovement[] @relation("InventoryMovementCreatedBy")
  createdPayments       Payment[]           @relation("PaymentCreatedBy")
  createdPayrollPeriods PayrollPeriod[]     @relation("PayrollPeriodCreatedBy")
  createdSales          Sale[]              @relation("SaleCreatedBy")
  employee              Employee?
  organization          Organization        @relation(fields: [organizationId], references: [id])
  userRoles             UserRole[]

  @@unique([organizationId, email])
  @@map("users")
}

model Role {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  userRoles      UserRole[]

  @@unique([organizationId, key])
  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Employee {
  id                   String              @id @default(uuid()) @db.Uuid
  organizationId       String              @map("organization_id") @db.Uuid
  branchId             String?             @map("branch_id") @db.Uuid
  userId               String?             @unique @map("user_id") @db.Uuid
  firstName            String              @map("first_name")
  lastName             String              @map("last_name")
  email                String?
  phone                String?
  jobTitle             String              @map("job_title")
  hireDate             DateTime?           @map("hire_date") @db.Date
  baseSalary           Decimal?            @map("base_salary") @db.Decimal(12, 2)
  commissionRate       Decimal?            @map("commission_rate") @db.Decimal(5, 2)
  status               EmployeeStatus      @default(active)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  deletedAt            DateTime?           @map("deleted_at")
  appointments         Appointment[]       @relation("AppointmentOptometrist")
  branch               Branch?             @relation(fields: [branchId], references: [id])
  organization         Organization        @relation(fields: [organizationId], references: [id])
  payrollPeriodItems   PayrollPeriodItem[]
  prescriptions        Prescription[]      @relation("PrescriptionOptometrist")
  sales                Sale[]              @relation("SaleSeller")
  user                 User?               @relation(fields: [userId], references: [id])

  @@index([organizationId, status])
  @@map("employees")
}

model Customer {
  id                     String          @id @default(uuid()) @db.Uuid
  organizationId         String          @map("organization_id") @db.Uuid
  firstName              String          @map("first_name")
  lastName               String?         @map("last_name")
  phone                  String?
  email                  String?
  birthDate              DateTime?       @map("birth_date") @db.Date
  address                String?
  preferredContactMethod ContactMethod?  @map("preferred_contact_method")
  notes                  String?
  marketingOptIn         Boolean         @default(false) @map("marketing_opt_in")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  deletedAt              DateTime?       @map("deleted_at")
  appointments           Appointment[]
  organization           Organization    @relation(fields: [organizationId], references: [id])
  prescriptions          Prescription[]
  sales                  Sale[]

  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@map("customers")
}

model Prescription {
  id                    String      @id @default(uuid()) @db.Uuid
  organizationId        String      @map("organization_id") @db.Uuid
  customerId            String      @map("customer_id") @db.Uuid
  optometristEmployeeId String?     @map("optometrist_employee_id") @db.Uuid
  appointmentId         String?     @map("appointment_id") @db.Uuid
  prescriptionDate      DateTime    @map("prescription_date") @db.Date
  rightSphere           Decimal?    @map("right_sphere") @db.Decimal(5, 2)
  rightCylinder         Decimal?    @map("right_cylinder") @db.Decimal(5, 2)
  rightAxis             Int?        @map("right_axis")
  leftSphere            Decimal?    @map("left_sphere") @db.Decimal(5, 2)
  leftCylinder          Decimal?    @map("left_cylinder") @db.Decimal(5, 2)
  leftAxis              Int?        @map("left_axis")
  pupillaryDistance     Decimal?    @map("pupillary_distance") @db.Decimal(5, 2)
  addition              Decimal?    @db.Decimal(5, 2)
  diagnosisNotes        String?     @map("diagnosis_notes")
  version               Int         @default(1)
  isActive              Boolean     @default(true) @map("is_active")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  appointment           Appointment? @relation(fields: [appointmentId], references: [id])
  customer              Customer    @relation(fields: [customerId], references: [id])
  optometrist           Employee?   @relation("PrescriptionOptometrist", fields: [optometristEmployeeId], references: [id])
  organization          Organization @relation(fields: [organizationId], references: [id])
  saleItems             SaleItem[]

  @@index([customerId, prescriptionDate])
  @@map("prescriptions")
}

model Appointment {
  id                    String            @id @default(uuid()) @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  branchId              String            @map("branch_id") @db.Uuid
  customerId            String            @map("customer_id") @db.Uuid
  optometristEmployeeId String?           @map("optometrist_employee_id") @db.Uuid
  scheduledStart        DateTime          @map("scheduled_start")
  scheduledEnd          DateTime?         @map("scheduled_end")
  reason                String?
  status                AppointmentStatus @default(scheduled)
  source                AppointmentSource @default(web)
  notes                 String?
  createdByUserId       String?           @map("created_by_user_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  branch                Branch            @relation(fields: [branchId], references: [id])
  createdBy             User?             @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id])
  customer              Customer          @relation(fields: [customerId], references: [id])
  optometrist           Employee?         @relation("AppointmentOptometrist", fields: [optometristEmployeeId], references: [id])
  organization          Organization      @relation(fields: [organizationId], references: [id])
  prescriptions         Prescription[]

  @@index([branchId, scheduledStart])
  @@map("appointments")
}

model Category {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  slug           String
  type           CategoryType @default(product)
  parentId       String?      @map("parent_id") @db.Uuid
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  children       Category[]   @relation("CategoryHierarchy")
  organization   Organization @relation(fields: [organizationId], references: [id])
  parent         Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  products       Product[]

  @@unique([organizationId, slug])
  @@map("categories")
}

model Brand {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  slug           String
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  products       Product[]

  @@unique([organizationId, slug])
  @@map("brands")
}

model Product {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  categoryId      String              @map("category_id") @db.Uuid
  brandId         String?             @map("brand_id") @db.Uuid
  sku             String?
  name            String
  slug            String
  description     String?
  productType     ProductType         @map("product_type")
  barcode         String?
  model           String?
  color           String?
  size            String?
  material        String?
  costPrice       Decimal?            @map("cost_price") @db.Decimal(12, 2)
  salePrice       Decimal             @map("sale_price") @db.Decimal(12, 2)
  taxRate         Decimal?            @map("tax_rate") @db.Decimal(5, 2)
  trackInventory  Boolean             @default(true) @map("track_inventory")
  reorderPoint    Int?                @map("reorder_point")
  isActive        Boolean             @default(true) @map("is_active")
  isPublic        Boolean             @default(true) @map("is_public")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  deletedAt       DateTime?           @map("deleted_at")
  brand           Brand?              @relation(fields: [brandId], references: [id])
  category        Category            @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  inventoryMoves  InventoryMovement[]
  inventoryStock  InventoryStock[]
  organization    Organization        @relation(fields: [organizationId], references: [id])
  saleItems       SaleItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, slug])
  @@index([organizationId, productType])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isPrimary])
  @@map("product_images")
}

model Supplier {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  name           String
  contactName    String?             @map("contact_name")
  phone          String?
  email          String?
  address        String?
  notes          String?
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  movements      InventoryMovement[]
  organization   Organization        @relation(fields: [organizationId], references: [id])

  @@map("suppliers")
}

model InventoryStock {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  branchId          String       @map("branch_id") @db.Uuid
  productId         String       @map("product_id") @db.Uuid
  quantityOnHand    Int          @default(0) @map("quantity_on_hand")
  quantityReserved  Int          @default(0) @map("quantity_reserved")
  quantityAvailable Int          @default(0) @map("quantity_available")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  branch            Branch       @relation(fields: [branchId], references: [id])
  organization      Organization @relation(fields: [organizationId], references: [id])
  product           Product      @relation(fields: [productId], references: [id])

  @@unique([branchId, productId])
  @@map("inventory_stock")
}

model InventoryMovement {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @map("organization_id") @db.Uuid
  branchId        String                @map("branch_id") @db.Uuid
  productId       String                @map("product_id") @db.Uuid
  supplierId      String?               @map("supplier_id") @db.Uuid
  movementType    InventoryMovementType @map("movement_type")
  quantity        Int
  unitCost        Decimal?              @map("unit_cost") @db.Decimal(12, 2)
  reason          String?
  referenceType   String?               @map("reference_type")
  referenceId     String?               @map("reference_id") @db.Uuid
  createdByUserId String?               @map("created_by_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at")
  branch          Branch                @relation(fields: [branchId], references: [id])
  createdBy       User?                 @relation("InventoryMovementCreatedBy", fields: [createdByUserId], references: [id])
  organization    Organization          @relation(fields: [organizationId], references: [id])
  product         Product               @relation(fields: [productId], references: [id])
  supplier        Supplier?             @relation(fields: [supplierId], references: [id])

  @@index([productId, createdAt])
  @@map("inventory_movements")
}

model Sale {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  branchId          String       @map("branch_id") @db.Uuid
  customerId        String?      @map("customer_id") @db.Uuid
  sellerEmployeeId  String?      @map("seller_employee_id") @db.Uuid
  saleNumber        String       @map("sale_number")
  status            SaleStatus   @default(quote)
  currency          String       @default("MXN")
  subtotal          Decimal      @default(0) @db.Decimal(12, 2)
  discountTotal     Decimal      @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal          Decimal      @default(0) @map("tax_total") @db.Decimal(12, 2)
  total             Decimal      @default(0) @db.Decimal(12, 2)
  paidTotal         Decimal      @default(0) @map("paid_total") @db.Decimal(12, 2)
  balanceDue        Decimal      @default(0) @map("balance_due") @db.Decimal(12, 2)
  notes             String?
  confirmedAt       DateTime?    @map("confirmed_at")
  cancelledAt       DateTime?    @map("cancelled_at")
  createdByUserId   String?      @map("created_by_user_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  branch            Branch       @relation(fields: [branchId], references: [id])
  createdBy         User?        @relation("SaleCreatedBy", fields: [createdByUserId], references: [id])
  customer          Customer?    @relation(fields: [customerId], references: [id])
  items             SaleItem[]
  organization      Organization @relation(fields: [organizationId], references: [id])
  payments          Payment[]
  seller            Employee?    @relation("SaleSeller", fields: [sellerEmployeeId], references: [id])

  @@unique([branchId, saleNumber])
  @@index([organizationId, createdAt])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id                String            @id @default(uuid()) @db.Uuid
  saleId            String            @map("sale_id") @db.Uuid
  productId         String?           @map("product_id") @db.Uuid
  prescriptionId    String?           @map("prescription_id") @db.Uuid
  description       String
  quantity          Int
  unitPrice         Decimal           @map("unit_price") @db.Decimal(12, 2)
  discountAmount    Decimal           @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount         Decimal           @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal         Decimal           @map("line_total") @db.Decimal(12, 2)
  fulfillmentStatus FulfillmentStatus @default(pending) @map("fulfillment_status")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  prescription      Prescription?     @relation(fields: [prescriptionId], references: [id])
  product           Product?          @relation(fields: [productId], references: [id])
  sale              Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_items")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  saleId          String        @map("sale_id") @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("MXN")
  paymentMethod   PaymentMethod @map("payment_method")
  status          PaymentStatus @default(pending)
  reference       String?
  paidAt          DateTime?     @map("paid_at")
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  createdBy       User?         @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id])
  organization    Organization  @relation(fields: [organizationId], references: [id])
  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("payments")
}

model PayrollPeriod {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  branchId        String?             @map("branch_id") @db.Uuid
  startDate       DateTime            @map("start_date") @db.Date
  endDate         DateTime            @map("end_date") @db.Date
  status          PayrollStatus       @default(draft)
  notes           String?
  createdByUserId String?             @map("created_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  branch          Branch?             @relation(fields: [branchId], references: [id])
  createdBy       User?               @relation("PayrollPeriodCreatedBy", fields: [createdByUserId], references: [id])
  items           PayrollPeriodItem[]
  organization    Organization        @relation(fields: [organizationId], references: [id])

  @@map("payroll_periods")
}

model PayrollPeriodItem {
  id              String        @id @default(uuid()) @db.Uuid
  payrollPeriodId String        @map("payroll_period_id") @db.Uuid
  employeeId      String        @map("employee_id") @db.Uuid
  baseSalary      Decimal       @default(0) @map("base_salary") @db.Decimal(12, 2)
  commissions     Decimal       @default(0) @db.Decimal(12, 2)
  bonuses         Decimal       @default(0) @db.Decimal(12, 2)
  deductions      Decimal       @default(0) @db.Decimal(12, 2)
  grossTotal      Decimal       @default(0) @map("gross_total") @db.Decimal(12, 2)
  netTotal        Decimal       @default(0) @map("net_total") @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  employee        Employee      @relation(fields: [employeeId], references: [id])
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)

  @@unique([payrollPeriodId, employeeId])
  @@map("payroll_period_items")
}
