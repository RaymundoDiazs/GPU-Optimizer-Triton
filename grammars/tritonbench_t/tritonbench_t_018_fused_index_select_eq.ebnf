(* Contract for TritonBench-T example 018.
   Target wrapper: fused_index_select_eq(input, dim, index, other, *, out=None)
   -> Tensor. *)

module = imports, kernel, wrapper ;

imports = "import torch", newline,
          "import triton", newline,
          "import triton.language as tl", newline ;

kernel = "@triton.jit", newline,
         "def", identifier, "(", parameters, ")", ":", newline,
         indexing_body ;

indexing_body = offsets, mask, load_index, select_input, compare_equal, store ;

offsets = statement_with("tl.program_id"), statement_with("tl.arange") ;
mask = statement_with("mask") ;
load_index = statement_with("tl.load") ;
select_input = statement_with("index")
             | statement_with("dim")
             | statement_with("tl.load") ;
compare_equal = statement_with("==")
              | statement_with("tl.equal")
              | statement_with("eq") ;
store = statement_with("tl.store") ;

wrapper = "def fused_index_select_eq", "(", wrapper_parameters, ")", ":", newline,
          { statement } ;

identifier = letter, { letter | digit | "_" } ;
parameters = { character } ;
wrapper_parameters = { character } ;
statement = { character }, newline ;
statement_with(token) = { character }, token, { character }, newline ;
newline = "\n" ;
