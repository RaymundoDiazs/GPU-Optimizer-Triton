(* Contract for TritonBench-T example 015.
   Target wrapper: fused_mv_logsoftmax_dropout(input, vec, p=0.5,
   training=True, inplace=False, dim=0, *, out=None) -> Tensor. *)

module = imports, kernel, wrapper ;

imports = "import torch", newline,
          "import triton", newline,
          "import triton.language as tl", newline ;

kernel = "@triton.jit", newline,
         "def", identifier, "(", parameters, ")", ":", newline,
         fusion_body ;

fusion_body = offsets, masks, load_matrix, load_vector, matvec_operation,
              logsoftmax_operation, dropout_operation, store ;

offsets = statement_with("tl.program_id"), statement_with("tl.arange") ;
masks = statement_with("mask") ;
load_matrix = statement_with("tl.load") ;
load_vector = statement_with("tl.load") ;
matvec_operation = statement_with("tl.sum")
                 | statement_with("tl.dot")
                 | statement_with("*") ;
logsoftmax_operation = statement_with("log_softmax")
                     | statement_with("tl.log")
                     | statement_with("tl.exp")
                     | statement_with("tl.max") ;
dropout_operation = statement_with("dropout")
                  | statement_with("training")
                  | statement_with("p") ;
store = statement_with("tl.store") ;

wrapper = "def fused_mv_logsoftmax_dropout", "(", wrapper_parameters, ")", ":", newline,
          { statement } ;

identifier = letter, { letter | digit | "_" } ;
parameters = { character } ;
wrapper_parameters = { character } ;
statement = { character }, newline ;
statement_with(token) = { character }, token, { character }, newline ;
newline = "\n" ;
