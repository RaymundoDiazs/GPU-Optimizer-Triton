(* Contract for TritonBench-T example 014.
   Target wrapper: dropout_relu_batch_norm_conv2d(input, weight, bias=None,
   stride=1, padding=0, dilation=1, groups=1, p=0.5, training=True,
   inplace=False) -> Tensor. *)

module = imports, one_or_more_kernels, wrapper ;

imports = "import torch", newline,
          "import triton", newline,
          "import triton.language as tl", newline ;

one_or_more_kernels = { decorator, kernel_def, kernel_body } ;

decorator = "@triton.jit", newline ;
kernel_def = "def", identifier, "(", parameters, ")", ":", newline ;
kernel_body = { statement } ;

wrapper = "def dropout_relu_batch_norm_conv2d", "(", wrapper_parameters, ")", ":", newline,
          { statement } ;

required_semantics = "convolution index mapping",
                     "loads input and weight",
                     "optional bias",
                     "batch normalization",
                     "relu activation",
                     "dropout handling",
                     "handles training and inplace" ;

identifier = letter, { letter | digit | "_" } ;
parameters = { character } ;
wrapper_parameters = { character } ;
statement = { character }, newline ;
newline = "\n" ;
