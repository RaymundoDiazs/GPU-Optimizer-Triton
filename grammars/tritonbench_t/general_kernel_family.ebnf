root ::= module

module ::= imports ws decorator ws kernel_def ws implementation ws launcher_def?

imports ::= torch_import triton_import language_import
torch_import ::= "import torch" newline
triton_import ::= "import triton" newline
language_import ::= "import triton.language as tl" newline

decorator ::= "@triton.jit" newline
kernel_def ::= "def" ws identifier "(" text ")" ":" newline
launcher_def ::= "def" ws identifier "(" text ")" ":" newline statement*

implementation ::= elementwise_body
                 | reduction_body
                 | convolution_body
                 | matmul_or_fusion_body
                 | generic_kernel_body

elementwise_body ::= program_id offsets mask load+ assignment store
reduction_body ::= program_id offsets mask load+ reduction_expr store
convolution_body ::= program_id statement* load+ assignment statement* store
matmul_or_fusion_body ::= program_id statement* load+ assignment statement* store
generic_kernel_body ::= program_id statement* load+ statement* store

program_id ::= indent identifier ws "=" ws "tl.program_id(" integer ")" newline
offsets ::= indent identifier ws "=" ws text "tl.arange(" text ")" newline
mask ::= indent identifier ws "=" ws text newline
load ::= indent identifier ws "=" ws "tl.load(" text ")" newline
store ::= indent "tl.store(" text ")" newline
assignment ::= indent identifier ws "=" ws text newline
reduction_expr ::= assignment
statement ::= indent text newline

identifier ::= [a-zA-Z_][a-zA-Z0-9_]*
integer ::= [0-9]+
text ::= [^\n]*
indent ::= [ \t]+
ws ::= [ \t]*
newline ::= "\n"
