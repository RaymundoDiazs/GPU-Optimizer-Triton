# TritonBench-T general kernel grammar for XGrammar constrained decoding.
#
# Format: GBNF (GGML BNF) — the format XGrammar's GrammarCompiler accepts.
#
# Covers all 166 TritonBench-T operators. Enforces:
#   - Mandatory imports (torch, triton, triton.language as tl)
#   - @triton.jit decorator with kernel name ending in _kernel
#   - At least one tl.constexpr param
#   - Body with mandatory tl.program_id and tl.store
#   - Mandatory launcher/wrapper function (distinct name from kernel)
#
# v6 + bad_words_ids — best grammar (4/30 = 13.3%) combined with token-level
#   .data_ptr() ban via bad_words_ids=[[2196, 4348]] in generate().
#   The grammar stays SIMPLE (lesson from v7: complex structure destroys output).
#   The .data_ptr() problem (55% of predictions) is handled at token level,
#   not grammar level — GBNF cannot do negative lookahead.

root ::= module

module ::= imports kernel launcher

# ----- imports -----
imports ::= torch_import triton_import tl_import
          | triton_import tl_import

torch_import  ::= "import torch\n"
triton_import ::= "import triton\n"
tl_import     ::= "import triton.language as tl\n\n"

# ----- kernel -----
kernel ::= "@triton.jit\n" "def " ident "_kernel(" params "):\n" body

params      ::= pre_params constexpr_p post_params
pre_params  ::= (plain_p ", "){0,12}
post_params ::= (", " plain_p){0,12}
plain_p     ::= ident
constexpr_p ::= ident ": tl.constexpr"

# ----- kernel body -----
body ::= lead pid_line mid store_line tail

lead ::= free_line{0,6}
mid  ::= free_line{0,45}
tail ::= free_line{0,8}

pid_line   ::= "    " ident " = tl.program_id(" pid_arg ")\n"
store_line ::= "    tl.store(" stmt_text ")\n"
free_line  ::= "    " stmt_text "\n"

# ----- launcher / wrapper -----
launcher        ::= "\ndef " ident "(" launcher_params "):\n" launcher_body
launcher_params ::= launcher_param_char{0,250}
launcher_param_char ::= [a-zA-Z0-9_ \t.,:;=+\-*/<>&|\[\]'"\{\}]

launcher_body ::= launcher_line{1,40}
launcher_line ::= "    " stmt_text "\n"

# ----- terminals -----
ident     ::= [a-zA-Z_] [a-zA-Z0-9_]{0,60}
pid_arg   ::= [0-9a-zA-Z_=, ]{1,20}
stmt_text ::= stmt_char{1,200}
stmt_char ::= [a-zA-Z0-9_ \t.,:;=+\-*/%<>()&|\[\]'"\{\}#@]
