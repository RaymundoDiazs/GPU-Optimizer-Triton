(* General TritonBench-T family grammar.
   Purpose: choose a reusable grammar by operation family instead of writing
   one grammar per benchmark example.

   This file is intentionally higher-level than the individual contracts. It
   describes the structure that XGrammar/constrained decoding should select
   after classifying the task family. *)

module = imports, decorator, kernel_def, implementation, [launcher_def] ;

imports = torch_import, triton_imports ;
torch_import = "import torch", newline ;
triton_imports = "import triton", newline,
                 "import triton.language as tl", newline ;

launcher_def = "def", launcher_name, "(", wrapper_parameters, ")", ":", newline, launcher_body ;

implementation = elementwise_body
               | reduction_body
               | convolution_body
               | matmul_or_fusion_body
               | generic_kernel_body ;

decorator = "@triton.jit", newline ;
kernel_def = "def", kernel_name, "(", kernel_parameters, ")", ":", newline ;
program_id = identifier, ws, "=", ws, "tl.program_id", "(", integer, ")", newline ;
offsets = identifier, ws, "=", ws, "tl.arange", "(", integer, ",", ws, identifier, ")", newline ;
mask = identifier, ws, "=", ws, "tl.load", "(", text, ")", newline ;
load = identifier, ws, "=", ws, "tl.load", "(", text, ")", newline ;
store = "tl.store", "(", text, ")", newline ;
one_or_more_loads = load, { load } ;

elementwise_body = program_id, offsets, mask, one_or_more_loads, elementwise_expr, store ;
reduction_body = program_id, offsets, mask, one_or_more_loads, reduction_expr, store ;
convolution_body = program_id, index_mapping, input_weight_loads, convolution_expr, optional_bias, activation, store ;
matmul_or_fusion_body = program_id, tiled_offsets, matrix_loads, dot_or_multiply, optional_normalization, optional_activation, optional_dropout, store ;
generic_kernel_body = program_id, offsets, one_or_more_loads, optional_computation, store ;

elementwise_expr = assignment ;
reduction_expr = assignment ;
convolution_expr = assignment ;
dot_or_multiply = assignment ;
optional_bias = [ statement ] ;
optional_normalization = [ statement ] ;
optional_activation = [ statement ] ;
optional_dropout = [ statement ] ;
optional_computation = [ assignment ] ;

assignment = identifier, ws, "=", ws, text, newline ;

launcher_name = identifier ;

kernel_name = identifier ;
function_name = identifier ;

kernel_parameters = [ kernel_param, { ",", ws, kernel_param } ] ;
kernel_param = identifier, [ ":", ws, "tl.constexpr" ] ;
wrapper_parameters = [ wrapper_param, { ",", ws, wrapper_param } ] ;
wrapper_param = identifier ;

wrapper_body = { statement } ;
statement = { character }, newline ;
identifier = letter, { letter | digit | "_" } ;
integer = digit, { digit } ;
text = { character } ;

ws = { " " | "\t" } ;
newline = "\n" ;
character = any ;

letter = ? [A-Za-z] ? ;
digit = ? [0-9] ? ;
any = ? [\s\S] ? ;
empty = "" ;
