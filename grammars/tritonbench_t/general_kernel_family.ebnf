# TritonBench-T family grammar for XGrammar constrained decoding.
# Family labels used by selector tests: elementwise_kernel, reduction_kernel.
root ::= module

module ::= imports ws kernel
         | imports ws kernel ws launcher

imports ::= triton-imports
          | torch-import triton-imports

torch-import ::= "import torch" ws
triton-imports ::= "import triton" ws "import triton.language as tl" ws

kernel ::= decorator ws function-def ws body
decorator ::= "@triton.jit"
function-def ::= "def" ws identifier "(" params? ")" ":"

launcher ::= "def" ws identifier "(" wrapper-params? ")" ":" ws launcher-body
launcher-body ::= line*

body ::= line+
line ::= indent statement ws
statement ::= program-id
            | arange
            | load
            | store
            | assignment
            | generic-statement

program-id ::= identifier opt-ws "=" opt-ws "tl.program_id(" integer ")"
arange ::= identifier opt-ws "=" opt-ws "tl.arange(" integer "," opt-ws arange-end ")"
load ::= identifier opt-ws "=" opt-ws "tl.load(" text ")"
store ::= "tl.store(" text ")"
assignment ::= identifier opt-ws "=" opt-ws text
generic-statement ::= text

params ::= param ("," opt-ws param)*

param ::= identifier
        | identifier ":" opt-ws "tl.constexpr"
        | identifier opt-ws "=" opt-ws text
        | identifier ":" opt-ws "tl.constexpr" opt-ws "=" opt-ws text

wrapper-params ::= text

arange-end ::= integer
             | identifier

identifier ::= [a-zA-Z_][a-zA-Z0-9_]*
integer ::= [0-9]+
indent ::= [ \t]*
opt-ws ::= [ \t]*
ws ::= [ \t\n]+
text ::= [^\n]+
