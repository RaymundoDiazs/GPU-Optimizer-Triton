(* Contract for TritonBench-T example 020.
   Target wrapper: fused_lu_solve(A, b) -> Tensor. *)

module = imports, implementation, wrapper ;

imports = "import torch", newline,
          "import triton", newline,
          "import triton.language as tl", newline ;

implementation = documented_fallback | one_or_more_kernels ;

documented_fallback = statement_with("torch.linalg.lu_factor")
                    | statement_with("torch.linalg.lu_solve")
                    | statement_with("torch.linalg.solve")
                    | statement_with("torch.linalg") ;

one_or_more_kernels = { decorator, kernel_def, kernel_body } ;
decorator = "@triton.jit", newline ;
kernel_def = "def", identifier, "(", parameters, ")", ":", newline ;
kernel_body = { statement } ;

wrapper = "def fused_lu_solve", "(", wrapper_parameters, ")", ":", newline,
          { statement } ;

required_semantics = "LU decomposition",
                     "solves Ax equals b",
                     "handles matrix A",
                     "handles right hand side b",
                     "returns solution tensor" ;

identifier = letter, { letter | digit | "_" } ;
parameters = { character } ;
wrapper_parameters = { character } ;
statement = { character }, newline ;
statement_with(token) = { character }, token, { character }, newline ;
newline = "\n" ;
