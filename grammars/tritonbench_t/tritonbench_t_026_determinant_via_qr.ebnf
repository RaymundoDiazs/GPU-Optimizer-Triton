(* Contract for TritonBench-T example 026.
   Target wrapper: determinant_via_qr(...)
   Family: complex linear algebra operation. *)

module = imports, implementation, wrapper ;

imports = "import torch", newline,
          "import triton", newline,
          "import triton.language as tl", newline ;

implementation = family_kernel | documented_fallback ;

family_kernel = "@triton.jit", newline,
                "def", identifier, "(", parameters, ")", ":", newline,
                family_body ;

family_body = { statement } ;

documented_fallback = statement_with("torch.") ;

wrapper = "def determinant_via_qr", "(", wrapper_parameters, ")", ":", newline,
          { statement } ;

required_semantics = "wrapper name: determinant_via_qr",
                     "family: complex_linalg",
                     "operation-specific semantic evidence" ;

identifier = letter, { letter | digit | "_" } ;
parameters = { character } ;
wrapper_parameters = { character } ;
statement = { character }, newline ;
statement_with(token) = { character }, token, { character }, newline ;
newline = "\n" ;
