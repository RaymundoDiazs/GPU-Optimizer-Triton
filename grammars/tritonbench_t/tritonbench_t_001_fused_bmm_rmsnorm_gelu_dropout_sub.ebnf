(* Contract for TritonBench-T example 001.
   Target wrapper: fused_bmm_rmsnorm_gelu_dropout_sub(...)
   This is a module-level contract, not a full Python grammar. *)

module = imports, one_or_more_kernels, wrapper ;

imports = "import torch", newline,
          "import triton", newline,
          "import triton.language as tl", newline ;

one_or_more_kernels = { decorator, kernel_def, kernel_body } ;

decorator = "@triton.jit", newline ;
kernel_def = "def", identifier, "(", parameters, ")", ":", newline ;
kernel_body = { statement } ;

wrapper = "def fused_bmm_rmsnorm_gelu_dropout_sub", "(", wrapper_parameters, ")", ":", newline,
          { statement } ;

required_semantics = "batched matrix multiplication or dot",
                     "normalization/rms operation",
                     "gelu activation",
                     "dropout handling",
                     "subtraction from other",
                     "returns or writes output" ;

identifier = letter, { letter | digit | "_" } ;
parameters = { character } ;
wrapper_parameters = { character } ;
statement = { character }, newline ;
newline = "\n" ;
