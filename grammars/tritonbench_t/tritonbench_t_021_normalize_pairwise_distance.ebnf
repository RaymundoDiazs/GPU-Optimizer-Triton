(* Contract for TritonBench-T example 021.
   Target wrapper: normalize_pairwise_distance(x1, x2, p_distance=2.0,
   eps_distance=1e-6, keepdim=False, p_norm=2, dim_norm=1,
   eps_norm=1e-12) -> Tensor. *)

module = imports, implementation, wrapper ;

imports = "import torch", newline,
          "import triton", newline,
          "import triton.language as tl", newline ;

implementation = kernel | documented_fallback ;

kernel = "@triton.jit", newline,
         "def", identifier, "(", parameters, ")", ":", newline,
         distance_norm_body ;

distance_norm_body = offsets, mask, load_x1, load_x2, pairwise_distance,
                     normalize_distance, store ;

offsets = statement_with("tl.program_id"), statement_with("tl.arange") ;
mask = statement_with("mask") ;
load_x1 = statement_with("tl.load") ;
load_x2 = statement_with("tl.load") ;
pairwise_distance = statement_with("p_distance")
                  | statement_with("eps_distance")
                  | statement_with("tl.abs")
                  | statement_with("tl.sum") ;
normalize_distance = statement_with("p_norm")
                   | statement_with("dim_norm")
                   | statement_with("eps_norm")
                   | statement_with("tl.sqrt") ;
store = statement_with("tl.store") ;

documented_fallback = statement_with("pairwise_distance")
                    | statement_with("normalize") ;

wrapper = "def normalize_pairwise_distance", "(", wrapper_parameters, ")", ":", newline,
          { statement } ;

identifier = letter, { letter | digit | "_" } ;
parameters = { character } ;
wrapper_parameters = { character } ;
statement = { character }, newline ;
statement_with(token) = { character }, token, { character }, newline ;
newline = "\n" ;
