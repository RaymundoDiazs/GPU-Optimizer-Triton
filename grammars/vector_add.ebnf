(* Narrow EBNF grammar for a Triton vector-add kernel.
   Target operation: Z = X + Y for N elements.
   This is a project grammar contract, not a universal Python/Triton grammar. *)

kernel_file = imports, blank_line, decorator, function_def, block ;

imports = "import triton", newline,
          "import triton.language as tl", newline ;

decorator = "@triton.jit", newline ;

function_def = "def vector_add_kernel",
               "(",
               "X", ", ",
               "Y", ", ",
               "Z", ", ",
               "N", ": ", "tl.constexpr", ", ",
               "BLOCK_SIZE", ": ", "tl.constexpr",
               ")", ":", newline ;

block = indent, "pid = tl.program_id(0)", newline,
        indent, "offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)", newline,
        indent, "mask = offsets < N", newline,
        indent, "x = tl.load(X + offsets, mask=mask)", newline,
        indent, "y = tl.load(Y + offsets, mask=mask)", newline,
        indent, "tl.store(Z + offsets, x + y, mask=mask)", newline ;

blank_line = newline ;
indent = "    " ;
newline = "\n" ;

